SKILLEVAL_ENV=local
SKILLEVAL_DB_HOST=localhost
SKILLEVAL_DB_PORT=5432
SKILLEVAL_DB_USER=skill_evaluate
SKILLEVAL_DB_PASSWORD=changeme
SKILLEVAL_DB_DATABASE=skill_evaluate
# ---- LLM：全项目统一经 OpenRouter 访问（OpenAI 兼容协议） ----
# OpenRouter 控制台申请的 Key（sk-or-v1-...）。也可以改用裸 OPENROUTER_API_KEY。
SKILLEVAL_LLM_API_KEY=sk-or-v1-...
# 默认端点；自建 OpenAI 兼容网关/代理时才需要改。
SKILLEVAL_LLM_BASE_URL=https://openrouter.ai/api/v1
# 模型 ID 用 OpenRouter 的 <厂商>/<模型> 写法（注意版本号是点号：claude-haiku-4.5）。
# 换厂商同样只改这三行，例如 openai/gpt-5.6-terra、google/gemini-3.5-flash。
SKILLEVAL_LLM_JUDGE_MODEL=anthropic/claude-sonnet-5
SKILLEVAL_LLM_GENERATOR_MODEL=anthropic/claude-sonnet-5
SKILLEVAL_LLM_MINI_AGENT_MODEL=anthropic/claude-haiku-4.5
SKILLEVAL_LLM_OPTIMIZER_MODEL=anthropic/claude-sonnet-5
# 可选：OpenRouter 用量排行的归因头，留空则不发送。
SKILLEVAL_LLM_HTTP_REFERER=
SKILLEVAL_LLM_APP_TITLE=
# ---- Judge（docs/dev/08 裁判可信度机制） ----
# 黄金基准盲测的注入概率（架构文档：每 50 次真实评测混入 1 次）。
SKILLEVAL_JUDGE_GOLDEN_INJECT_RATE=0.02
# 失误率超过该阈值即冻结对应 Judge 配置的评测权限。
SKILLEVAL_JUDGE_MISS_RATE_THRESHOLD=0.05
SKILLEVAL_JUDGE_HEALTH_WINDOW_SIZE=50
# 3 副本共识的扰动维度：perspective（默认，视角扰动）| temperature | model。
# 默认 judge_model 已移除采样参数，温度扰动在其上不成立，详见
# docs/dev/interfaces/06_llm_client_and_sampling.md 第 2 节。
SKILLEVAL_JUDGE_CONSENSUS_STRATEGY=perspective
# strategy=temperature 时生效；strategy=model 时改填 CONSENSUS_MODELS=["a","b","c"]。
SKILLEVAL_JUDGE_CONSENSUS_TEMPERATURES=[0.1,0.3,0.5]
SKILLEVAL_JUDGE_CONSENSUS_MODELS=[]
# ---- Optimizer（docs/dev/09 闭环重试） ----
# 达到该次数仍未通过回归时，安全挂起等待人工裁决，而不是直接判负。
SKILLEVAL_OPTIMIZER_MAX_RETRIES=3
SKILLEVAL_OPTIMIZER_TEMPERATURE=0.2
SKILLEVAL_EXECUTOR_BACKEND=mini
SKILLEVAL_EXECUTOR_HERMES_ENDPOINT=
SKILLEVAL_EXECUTOR_HERMES_HOOK_SECRET=
SKILLEVAL_LANGFUSE_ENABLED=false
SKILLEVAL_LANGFUSE_PUBLIC_KEY=
SKILLEVAL_LANGFUSE_SECRET_KEY=
SKILLEVAL_LANGFUSE_HOST=https://cloud.langfuse.com
